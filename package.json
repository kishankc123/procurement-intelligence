{
  "name": "procureintel",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel --no-bail --filter './apps/*' dev",
    "api": "json-server --watch mock/db.json --port 3001",
    "assistant": "tsx server/index.ts",
    "seed": "tsx mock/seed.ts",
    "reset-db": "tsx mock/seed.ts",
    "import-gppd": "tsx mock/import-gppd.ts",
    "build": "pnpm -r --filter './apps/*' build",
    "build:vercel": "DEPLOY=vercel pnpm build && node scripts/assemble-vercel.mjs",
    "demo": "pnpm build && pnpm preview",
    "preview": "pnpm -r --parallel --no-bail --filter './apps/*' preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "json-server": "0.17.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/react-query": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "*",
    "zustand": "*"
  }
}

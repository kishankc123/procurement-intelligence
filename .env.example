# Copy to .env.local (git-ignored) and fill in. Never commit the real file and never paste a key into chat.
OPENAI_API_KEY=
# Optional. Provider-prefixed model for the CopilotKit agent. Default: openai/gpt-4.1-mini
OPENAI_MODEL=

# --- Live ingestion on a hosted (Vercel) site; see docs/HOSTING.md. Set these in the Vercel project settings, not here. ---
# Turns live ingestion on. Without it the hosted site answers that ingestion is switched off. Anyone with this token can start ingestions (and spend OpenAI budget).
INGEST_TOKEN=
# Set automatically when a Blob store is connected to the Vercel project: BLOB_READ_WRITE_TOKEN, or on newer stores BLOB_STORE_ID (used with VERCEL_OIDC_TOKEN, which `vercel env pull` provides and which expires after about 12 hours).
# Needed locally only to run `pnpm ingest:index` against Blob. BLOB_WEBHOOK_PUBLIC_KEY is not used.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# 'private' (default) or 'public': must match how the Blob store was created.
INGEST_BLOB_ACCESS=
# Optional. Ingestions a day (default 5), seconds of work per request in milliseconds (default 30000; keep well below the function's maxDuration, because a download or a model call that has started finishes), and chunks embedded per project (default 3000).
INGEST_DAILY_LIMIT=
INGEST_STEP_BUDGET_MS=
INGEST_MAX_CHUNKS=
